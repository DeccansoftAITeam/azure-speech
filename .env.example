# Foundry / Azure OpenAI endpoint (examples 01-03, Entra ID auth via `az login`)
AZURE_OPENAI_ENDPOINT=https://<your-resource>.services.ai.azure.com
TTS_DEPLOYMENT=gpt-4o-mini-tts
TRANSCRIBE_DEPLOYMENT=gpt-4o-mini-transcribe

# Azure AI Speech / Foundry resource (examples 04-09)
SPEECH_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/
SPEECH_KEY=<your-key>

# New demos (10-12)
VOICE_LIVE_MODEL=gpt-realtime-mini
DIARIZE_DEPLOYMENT=gpt-4o-transcribe-diarize
AUDIO_CHAT_DEPLOYMENT=gpt-audio-mini
